/**
 * 构建水印（显示在设置页版本行的副标题里）—— 对位原工程 `BuildConfig.BUILD_COMMIT`。
 *
 * ## 为什么需要一个水印
 *
 * 用户报一个问题时，最先要确认的是「他装的是不是含这个修复的那个包」。只有版本号
 * `1.0.2` 是不够的 —— 同一个版本号下我们可能出过好几个包（改一处、重出一次），
 * 而用户手机上的那一个到底是哪个，谁也说不清。带上提交短哈希，一句话就能对上。
 *
 * ## 为什么是「生成的文件」而不是自己维护
 *
 * 这个值**只能**来自 `git rev-parse --short HEAD`，人手维护必然过期。
 * 所以它由 `scripts/build-stamp.sh` 在**出包前**重写一次 —— 于是它的语义正好是
 * 「这个包是从哪个提交出来的」，而不是「当前仓库在哪」。
 *
 * 与安卓的差异：安卓用 Gradle 把值注入 `BuildConfig`（`build/apk` 里现生成）；
 * hvigor 也有同名机制（`build-profile.json5` 的 `buildOption.buildProfileFields`），
 * 但那条路要靠 `import ... from 'BuildProfile'` 引生成模块 —— 在**无法编译验证**的前提下
 * 引入一个新的模块解析方式，风险大于收益。改成生成一个普通 ArkTS 源文件，
 * 编译路径与其它 `core/*.ts` 完全一样。
 *
 * ## 空串是合法取值
 *
 * 没跑过脚本（或脚本在非 git 环境里失败）时它就是空串，界面会只显示版本号 ——
 * 这比显示一个猜的哈希诚实，也比让设置页崩掉合理。
 */
export const BUILD_COMMIT: string = 'e8c51f3';
