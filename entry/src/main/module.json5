{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        // 分层图标（前景 + 背景），与 AppScope 侧同名资源会互相覆盖，故刻意用不同资源名。
        // 详见 AppScope/app.json5 里 `icon` 上方的注释。
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        // 启动页图标用的是**独立的单层图**（官方文档「生成单层图标」会产出 icon_startwindow.png），
        // 不要求分层，故 startIcon 保持单层 PNG。
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:reason_internet",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:reason_network_info",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      // ⚠️ 这里**故意没有** `ohos.permission.READ_PASTEBOARD`（2026-10-15 真机验证时删掉的）。
      //
      // 它不是普通 user_grant 权限，而是**受限权限**（system_basic 级，需 ACL 加白）：
      // 普通应用（apl=normal）把它写进 requestPermissions，**安装就会失败**，实测报
      //   9568329 install failed due to grant request permissions failed.
      //   PermissionName: ohos.permission.READ_PASTEBOARD
      // ——注意是「安装时」被拒，不是运行时被拒，所以它连包都装不上。
      //
      // 于是「一键读剪贴板」这条路对普通应用不存在：`getDataSync()` 必然抛错。
      // 读取已降级为「提示用户长按输入框用系统粘贴」（系统粘贴不经过应用权限），
      // 写剪贴板（复制）本来就不需要权限，保留。
      // 若将来拿到 ACL 批准（AGC 侧把该权限加进 Profile 的 acls），可以把这条加回来。
    ]
  }
}
